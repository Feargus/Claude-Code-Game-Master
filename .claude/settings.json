{
  "statusLine": {
    "type": "command",
    "command": "bash tools/gm-statusline.sh"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-autosave.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-backup.sh"
          }
        ]
      }
    ]
  }
}
